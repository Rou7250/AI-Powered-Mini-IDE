# ---- LLM ----
# provider: anthropic | openai  (openai works for any OpenAI-compatible endpoint)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Pick a model your account has access to; do not rely on a hard-coded default.
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=1600

# ---- Backend ----
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# ---- Agent ----
MAX_AGENT_ITERATIONS=5

# ---- RAG ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./chroma_data
MAX_CHUNK_LINES=60
CHUNK_OVERLAP_LINES=10
RAG_TOP_K=5

# ---- Code execution ----
CODE_EXECUTION_TIMEOUT=10
DOCKER_MEMORY_LIMIT=256m
DOCKER_CPU_LIMIT=0.5
# Dev only. Runs code on the host WITHOUT sandboxing when Docker is unavailable.
ALLOW_LOCAL_FALLBACK=false

# ---- Limits ----
MAX_FILE_SIZE_MB=5
MAX_PROJECT_SIZE_MB=100
MAX_OUTPUT_SIZE_KB=100

# Folder made available to containers by docker-compose
PROJECTS_DIR=./
